INTERACTIVE_WORKER_URL=wss://worker.example.com/worker/connect
INTERACTIVE_WORKER_TOKEN=
INTERACTIVE_WORKSPACE_PROFILE=
# Optional root/certificate only for the WSS socket, never a private key.
INTERACTIVE_WORKER_CA_FILE=
# Absolute test workspace; not a personal checkout. On Windows use native .exe binaries.
INTERACTIVE_CLI_CWD=
INTERACTIVE_CODEX_EXECUTABLE=
INTERACTIVE_CODEX_PROFILE_DIR=
# Optional Windows lab backend: app-server with a separate .codex-chat.env.
# Default: exec, which still requires its independent verifier.
INTERACTIVE_CODEX_BACKEND=exec
INTERACTIVE_CLAUDE_EXECUTABLE=
INTERACTIVE_CLAUDE_PROFILE_DIR=
# Leave empty until the lab operator provisions an independent local containment verifier.
INTERACTIVE_CLI_POLICY_EXECUTABLE=
