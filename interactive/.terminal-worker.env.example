TERMINAL_WORKER_URL=wss://terminal.example.com/worker/connect
TERMINAL_WORKER_ID=pc-test
TERMINAL_WORKER_TOKEN=
# Optional CA for this connection only. Keep TLS verification enabled.
TERMINAL_WORKER_CA_FILE=
# Configure at least one native Windows executable. Use absolute paths.
TERMINAL_CODEX_EXE=
TERMINAL_CLAUDE_EXE=
# Server sees only aliases, not these paths. Use existing, trusted local folders.
TERMINAL_WORKSPACES='{"scratch":"C:/work/scratch","demo-repo":"C:/work/demo-repo"}'
